    {
      "name": "Attendance",
      "item": [
        {
          "name": "Mark attendance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/attendance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attendance"
              ]
            },
            "description": "Access: faculty (own subject), admin. 201 sheet. 409 if already marked for the same subject, date and period. 400 for bad status, future date, student not enrolled.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"{{subjectId}}\",\n  \"date\": \"2026-08-10\",\n  \"period\": 2,\n  \"records\": [\n    {\n      \"student\": \"{{studentId}}\",\n      \"status\": \"present\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"attendanceId\", pm.response.json()._id);"
                ]
              }
            }
          ]
